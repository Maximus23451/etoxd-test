# Export variables in the shell before npm run dev / npm start.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:3001
# ConnectionStrings__Portal=Server=YOUR_SQL_SERVER;Database=EtoPortal;Integrated Security=true;Encrypt=True;TrustServerCertificate=False
# For local SQL Server, npm run db:start writes an ignored .runtime/config.json instead.
# APP_RUNTIME_DIR=/absolute/path/to/private/runtime-directory
# In production use ASPNETCORE_ENVIRONMENT=Production and HTTPS.
# DIAGNOSTICS=1 explicitly enables manager-only simulated errors outside Development.
# SEED_DEMO=1 explicitly enables demo seeding outside Development (development only).
